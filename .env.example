# DevOps Monitor Pro Environment Variables Example
# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

# Backend Config
PROJECT_NAME="DevOps Monitor Pro"
ENVIRONMENT="development"
SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY_CHANGE_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed password for the auto-created "admin" account on first boot only.
# Required (no default) when ENVIRONMENT=production. Change it via
# Settings > Change Password immediately after first login either way.
ADMIN_DEFAULT_PASSWORD="YOUR_INITIAL_ADMIN_PASSWORD_HERE"

# Database Config
POSTGRES_SERVER=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD="YOUR_POSTGRES_PASSWORD_HERE"
POSTGRES_DB=devops_monitor
POSTGRES_PORT=5432

# Redis Config
# Backs the login-rate-limiter's shared storage across backend replicas
# (see backend/app/core/limiter.py). Optional: if unreachable, the backend
# transparently falls back to in-memory rate limiting instead of failing
# to start - fine for a single-instance/dev deployment.
REDIS_HOST=redis
REDIS_PORT=6379

# Monitoring & Alerting
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD="YOUR_GRAFANA_ADMIN_PASSWORD_HERE"
ALERTMANAGER_PORT=9093

# Telegram Bot
# Used directly by the backend (app/services/notification_service.py) to
# call the real Telegram Bot API. There is no separate telegram-bot
# microservice - a previous one only logged messages locally without ever
# contacting Telegram, so it was removed rather than kept as decoration.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID_HERE"

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD="YOUR_SMTP_PASSWORD_HERE"

# Notes on alerting:
# - TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID and the SMTP_* vars above are the
#   secrets used to actually send notifications.
# - Whether each channel is ON, the alert recipient email, an optional
#   per-deployment Telegram chat ID override, and the CPU/RAM/Disk
#   thresholds are all configured live from Settings > Incident Alert
#   Dispatch Channels in the app (persisted to the app_settings table), not
#   from this file. This file only needs the secrets.
# - Prometheus/AlertManager run independently with their own static
#   thresholds (prometheus/alert_rules.yml) for infrastructure-level
#   visualization in Grafana; AlertManager's own receiver is intentionally
#   a no-op (see alertmanager/alertmanager.yml) so incidents aren't paged
#   twice through two different systems.
